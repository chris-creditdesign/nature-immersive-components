{
	"name": "nature-immersive-components",
	"files:": [
		"dist/*"
	],
	"main": "dist/index.js",
	"scripts": {
		"js-compile": "babel ./src --out-dir ./dist --ignore './src/*.test.js','./src/components/**/*.stories.jsx' --source-maps",
		"css-compile": "sass ./src/scss/index.scss ./dist/css/index.css",
		"css-compile-min": "sass ./src/scss/index.scss ./dist/css/index.min.css --style=compressed --source-map",
		"eslint": "eslint src/components/**/* --fix",
		"test": "jest",
		"prod": "yarn js-compile && yarn css-compile && yarn css-compile-min",
		"storybook": "start-storybook -s static"
	},
	"peerDependencies": {
		"react": "^16.8.6",
		"react-dom": "^16.8.6"
	},
	"dependencies": {
		"@storybook/addon-storyshots": "^5.2.1",
		"@storybook/react": "^5.1.9",
		"babel-plugin-macros": "^2.6.1",
		"css-loader": "^3.2.0",
		"enzyme": "^3.10.0",
		"enzyme-adapter-react-16": "^1.14.0",
		"jest": "^24.9.0",
		"prop-types": "^15.7.2",
		"require-context.macro": "^1.2.2",
		"sass": "^1.99.0",
		"sass-loader": "^8.0.0",
		"style-loader": "^1.0.0"
	},
	"devDependencies": {
		"@babel/cli": "^7.5.5",
		"@babel/core": "^7.4.0",
		"@babel/eslint-parser": "^7.28.6",
		"@babel/preset-env": "^7.4.2",
		"@babel/preset-react": "^7.0.0",
		"@eslint/eslintrc": "^3.3.5",
		"babel-loader": "^8.0.5",
		"eslint": "^9.39.4",
		"eslint-config-airbnb": "^19.0.4",
		"eslint-config-airbnb-base": "^15.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-html": "^8.1.4",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.6.0",
		"identity-obj-proxy": "^3.0.0",
		"prettier": "^3.8.3",
		"react-test-renderer": "^16.8.6",
		"webpack": "^4.29.6",
		"webpack-cli": "^3.3.0"
	},
	"pnpm": {
		"overrides": {
			"react-draggable": "4.4.6"
		},
		"peerDependencyRules": {
			"allowedVersions": {
				"eslint": "9",
				"eslint-plugin-react-hooks": "7"
			}
		}
	},
	"repository": {
		"type": "git",
		"url": ""
	},
	"author": "chris-creditdesign",
	"description": "React components used to render static html for @NatureNews immersive articles",
	"version": "0.0.1",
	"license": "ISC"
}
